@model IEnumerable<WMSPro.Mvc.Controllers.InventoryItemViewModel>
@{
    ViewData["Title"] = "Inventory";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Inventory Management</h1>
    <a href="/Inventory/Export" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-download fa-sm text-white-50"></i> Export
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Current Inventory Levels</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th>Product Name</th>
                        <th>SKU</th>
                        <th>Warehouse</th>
                        <th>Available Quantity</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.ProductName</strong></td>
                            <td>@item.SKU</td>
                            <td><i class="fas fa-warehouse text-gray-500 mr-1"></i> @item.WarehouseName</td>
                            <td>@item.Quantity units</td>
                            <td>
                                @if (item.Quantity > 20)
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                                else if (item.Quantity > 0)
                                {
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No inventory records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
