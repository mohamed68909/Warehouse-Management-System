@model IEnumerable<WMSPro.Mvc.Controllers.WarehouseViewModel>
@{
    ViewData["Title"] = "Warehouses";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Warehouses Management</h1>
    <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addWarehouseModal">
        <i class="fas fa-plus fa-sm text-white-50"></i> Add Warehouse
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    @foreach (var item in Model)
    {
        var usagePercent = item.Capacity > 0 ? (int)Math.Round((double)item.CurrentStock / item.Capacity * 100) : 0;
        var progressColor = usagePercent > 90 ? "bg-danger" : usagePercent > 75 ? "bg-warning" : "bg-success";

        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card shadow h-100 py-2 border-bottom-primary">
                <div class="card-body">
                    <div class="row no-gutters align-items-center mb-3">
                        <div class="col mr-2">
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@item.Name</div>
                            <div class="text-xs font-weight-bold text-muted text-uppercase mb-1">
                                <i class="fas fa-map-marker-alt"></i> @item.Location
                            </div>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#editWarehouseModal-@item.Id">
                                <i class="fas fa-edit"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block"><i class="fas fa-user"></i> @item.ManagerName</small>
                        <small class="text-muted d-block"><i class="fas fa-phone"></i> @item.Phone</small>
                        <small class="text-muted d-block"><i class="fas fa-envelope"></i> @item.Email</small>
                    </div>

                    <div class="mt-3">
                        <div class="d-flex justify-content-between text-xs mb-1">
                            <span class="font-weight-bold">Capacity Usage</span>
                            <span>@item.CurrentStock / @item.Capacity units (@usagePercent%)</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar @progressColor" role="progressbar" style="width: @usagePercent%" aria-valuenow="@usagePercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Warehouse Modal -->
        <div class="modal fade" id="editWarehouseModal-@item.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" action="/Warehouses/Edit">
                        <div class="modal-header">
                            <h5 class="modal-title">Edit Warehouse: @item.Name</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="Id" value="@item.Id" />
                            <div class="mb-3">
                                <label class="form-label">Name</label>
                                <input type="text" class="form-control" name="Name" value="@item.Name" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Capacity (Units)</label>
                                <input type="number" class="form-control" name="Capacity" value="@item.Capacity" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Location</label>
                                <input type="text" class="form-control" name="Location" value="@item.Location" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Manager Name</label>
                                <input type="text" class="form-control" name="ManagerName" value="@item.ManagerName" required />
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Phone</label>
                                    <input type="text" class="form-control" name="Phone" value="@item.Phone" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" name="Email" value="@item.Email" required />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12 text-center mt-5">
            <p class="text-muted">No warehouses found.</p>
        </div>
    }
</div>

<!-- Add Warehouse Modal -->
<div class="modal fade" id="addWarehouseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Warehouses/Create">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Warehouse</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Warehouse Name</label>
                        <input type="text" class="form-control" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Capacity (Units)</label>
                        <input type="number" class="form-control" name="Capacity" value="1000" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input type="text" class="form-control" name="Location" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Manager Name</label>
                        <input type="text" class="form-control" name="ManagerName" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" name="Phone" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" name="Email" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Warehouse</button>
                </div>
            </form>
        </div>
    </div>
</div>
