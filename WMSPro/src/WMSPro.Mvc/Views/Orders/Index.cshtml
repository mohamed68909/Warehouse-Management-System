@model WMSPro.Mvc.Controllers.OrdersViewModel
@{
    ViewData["Title"] = "Orders";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Orders Management</h1>
    <button class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#createOrderModal">
        <i class="fas fa-plus fa-sm text-white-50"></i> Create Order
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row">
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Orders</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalOrders</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-clipboard-list fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Purchase Orders Total</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">$@Model.PurchaseOrdersTotal.ToString("N2")</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-shopping-cart fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Sales Orders Total</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">$@Model.SalesOrdersTotal.ToString("N2")</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-file-invoice-dollar fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <ul class="nav nav-tabs card-header-tabs" id="orderTabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link @(string.IsNullOrEmpty(Model.FilterType) ? "active" : "")" href="/Orders/Index">All Orders</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.FilterType == "Purchase" ? "active" : "")" href="/Orders/Index?type=Purchase">Purchase Orders</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.FilterType == "Sales" ? "active" : "")" href="/Orders/Index?type=Sales">Sales Orders</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="bg-light">
                    <tr>
                        <th>Order No.</th>
                        <th>Type</th>
                        <th>Supplier/Customer</th>
                        <th>Warehouse</th>
                        <th>Date</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>
                                @if (order.Type == "Purchase") { <span class="badge bg-info text-dark">Purchase</span> }
                                else { <span class="badge bg-primary">Sales</span> }
                            </td>
                            <td>@order.SupplierCustomerName</td>
                            <td>@order.WarehouseName</td>
                            <td>@order.Date.ToString("MMM dd, yyyy")</td>
                            <td>$@order.TotalAmount.ToString("N2")</td>
                            <td>
                                @if (order.Status == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                                else if (order.Status == "Processing") { <span class="badge bg-primary">Processing</span> }
                                else if (order.Status == "Completed") { <span class="badge bg-success">Completed</span> }
                                else { <span class="badge bg-danger">Cancelled</span> }
                            </td>
                            <td>
                                <!-- Actions -->
                                <button class="btn btn-sm btn-info text-white" data-bs-toggle="modal" data-bs-target="#viewOrderModal-@order.Id">
                                    <i class="fas fa-eye"></i> View
                                </button>
                                
                                <!-- View Modal -->
                                <div class="modal fade" id="viewOrderModal-@order.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Order Details: @order.OrderNumber</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row mb-3">
                                                    <div class="col-6"><strong>Type:</strong> @order.Type</div>
                                                    <div class="col-6"><strong>Status:</strong> @order.Status</div>
                                                    <div class="col-6"><strong>Party:</strong> @order.SupplierCustomerName</div>
                                                    <div class="col-6"><strong>Warehouse:</strong> @order.WarehouseName</div>
                                                </div>
                                                <table class="table table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th>Product</th>
                                                            <th>Qty</th>
                                                            <th>Unit Price</th>
                                                            <th>Total</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach(var item in order.Items)
                                                        {
                                                            <tr>
                                                                <td>@item.ProductName</td>
                                                                <td>@item.Quantity</td>
                                                                <td>$@item.UnitPrice.ToString("N2")</td>
                                                                <td>$@item.TotalPrice.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="modal-footer">
                                                @if (order.Status == "Pending" || order.Status == "Processing")
                                                {
                                                    <form method="post" action="/Orders/UpdateStatus" class="d-inline">
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <input type="hidden" name="status" value="Completed" />
                                                        <button type="submit" class="btn btn-success">Mark as Completed</button>
                                                    </form>
                                                    <form method="post" action="/Orders/UpdateStatus" class="d-inline">
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <input type="hidden" name="status" value="Cancelled" />
                                                        <button type="submit" class="btn btn-danger">Cancel Order</button>
                                                    </form>
                                                }
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Orders.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">No orders found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Order Modal -->
<div class="modal fade" id="createOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/Orders/Create">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Order Type</label>
                            <select class="form-select form-control" name="Type" required>
                                <option value="Purchase">Purchase Order (IN)</option>
                                <option value="Sales">Sales Order (OUT)</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Supplier / Customer Name</label>
                            <input type="text" class="form-control" name="SupplierCustomerName" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Warehouse</label>
                            <select class="form-select form-control" name="WarehouseId" required>
                                <option value="">-- Select Warehouse --</option>
                                @foreach(var w in Model.Warehouses)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <hr />
                    <h6 class="font-weight-bold">Order Items</h6>
                    <div id="orderItemsContainer">
                        <div class="row order-item mb-2">
                            <div class="col-md-5">
                                <select class="form-select form-control" name="Items[0].ProductId" onchange="setProductName(this, 0)" required>
                                    <option value="">-- Select Product --</option>
                                    @foreach(var p in Model.Products)
                                    {
                                        <option value="@p.Id" data-name="@p.Name" data-price="@p.Price">@p.Name</option>
                                    }
                                </select>
                                <input type="hidden" name="Items[0].ProductName" id="Items_0__ProductName" />
                            </div>
                            <div class="col-md-3">
                                <input type="number" class="form-control" name="Items[0].Quantity" placeholder="Qty" required min="1" />
                            </div>
                            <div class="col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control" name="Items[0].UnitPrice" id="Items_0__UnitPrice" placeholder="Unit Price" required />
                                </div>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addOrderItem()">+ Add Item</button>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let itemIndex = 1;
        function addOrderItem() {
            var container = document.getElementById('orderItemsContainer');
            var html = `
                <div class="row order-item mb-2">
                    <div class="col-md-5">
                        <select class="form-select form-control" name="Items[${itemIndex}].ProductId" onchange="setProductName(this, ${itemIndex})" required>
                            <option value="">-- Select Product --</option>
                            @foreach(var p in Model.Products)
                            {
                                <option value="@p.Id" data-name="@p.Name" data-price="@p.Price">@p.Name</option>
                            }
                        </select>
                        <input type="hidden" name="Items[${itemIndex}].ProductName" id="Items_${itemIndex}__ProductName" />
                    </div>
                    <div class="col-md-3">
                        <input type="number" class="form-control" name="Items[${itemIndex}].Quantity" placeholder="Qty" required min="1" />
                    </div>
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" step="0.01" class="form-control" name="Items[${itemIndex}].UnitPrice" id="Items_${itemIndex}__UnitPrice" placeholder="Unit Price" required />
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', html);
            itemIndex++;
        }

        function setProductName(select, index) {
            var selectedOption = select.options[select.selectedIndex];
            var name = selectedOption.getAttribute('data-name');
            var price = selectedOption.getAttribute('data-price');
            document.getElementById(`Items_${index}__ProductName`).value = name;
            document.getElementById(`Items_${index}__UnitPrice`).value = price;
        }
    </script>
}
